# InvestIQ Backend — Environment Variable Template
# Copy this file to .env and fill in your own values.
# NEVER commit .env to version control.

# ── Flask ──────────────────────────────────────────────────────────────────
# Required: set to a long random string in production.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_a_random_32_char_secret

# Set to "True" for local development, "False" (or omit) for production.
FLASK_DEBUG=True

# ── CORS (production only) ─────────────────────────────────────────────────
# Required when FLASK_DEBUG=False. Comma-separated list of allowed origins.
# CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ── External APIs ──────────────────────────────────────────────────────────
# Alpha Vantage — get a free key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=YOUR_ALPHA_VANTAGE_KEY_HERE

# Google Gemini — get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
